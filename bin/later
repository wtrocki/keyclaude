#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
source "$SCRIPT_DIR/lib.sh"

DATA_ROOT="${KEYCLAUDE_DATA_REPO:-$HOME/notes/data}"
TASKS_FILE="$DATA_ROOT/backlog.md"

INPUT=$(cat)
[[ -z "$INPUT" ]] && { echo "Error: no input text" >&2; exit 1; }

CLIPBOARD=$(pbpaste 2>/dev/null || true)
SLACK_URL=""
if [[ "$CLIPBOARD" =~ https?://[a-zA-Z0-9.-]+\.slack\.com/archives/[^\ ]+ ]]; then
  SLACK_URL="$CLIPBOARD"
fi

CONTENT=$(printf '%s' "$INPUT")
FIRST_LINE=$(printf '%s' "$INPUT" | head -1)
if [[ -n "$SLACK_URL" ]]; then
  ENTRY="- [ ] $FIRST_LINE ([thread]($SLACK_URL))"
else
  ENTRY="- [ ] $FIRST_LINE"
fi
REST=$(printf '%s' "$INPUT" | tail -n +2)
if [[ -n "$REST" ]]; then
  ENTRY="$ENTRY"$'\n'"$(printf '%s' "$REST" | sed 's/^/  /')"
fi

PREVIEW=$(printf '%s' "$FIRST_LINE" | head -c 80)

mkdir -p "$DATA_ROOT"
printf '%s\n' "$ENTRY" >> "$TASKS_FILE"

afplay /System/Library/Sounds/Glass.aiff &
osascript -e 'display notification "'"$PREVIEW"'" with title "Later: Saved to backlog"' &
