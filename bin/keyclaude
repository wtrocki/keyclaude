#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib.sh"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DATA_ROOT="${KEYCLAUDE_DATA_REPO:-$HOME/notes/data}"

cmd_help() {
  echo "keyclaude — Engineering Personal Assistant"
  echo ""
  echo "Commands:"
  echo "  install          Run full setup (macOS shortcuts, config, brew deps)"
  echo "  config           Show current config"
  echo "  config set KEY=VAL  Set a config value"
  echo "  review <what>    Open a data file in Plannotator for review"
  echo ""
  echo "Review targets:"
  echo "  backlog          Task backlog"
  echo "  work-log         Work evidence log"
  echo "  weekly [N]       Weekly note (default: auto-detect current week)"
  echo "  writing          Writing insights"
  echo ""
  echo "Skills (also available as direct commands):"
  echo "  keyclaude-rewrite [default|leadership|external]"
  echo "  keyclaude-later"
  echo "  keyclaude-capture"
  echo "  keyclaude-leadership-feedback"
  echo "  keyclaude-weekly-init [YYYY-WNN]"
  echo "  keyclaude-weekly-review [YYYY-WNN]"
  echo "  keyclaude-monthly-review [YYYY-MM-DD]"
}

cmd_install() {
  "$REPO_ROOT/install.sh"
}

cmd_config() {
  local cmd="${1:-show}"
  case "$cmd" in
    show)
      if [[ -f "$HOME/.config/keyclaude/config" ]]; then
        cat "$HOME/.config/keyclaude/config"
      else
        echo "No config file at ~/.config/keyclaude/config"
      fi
      ;;
    set)
      local kv="${2:-}"
      [[ -z "$kv" ]] && { echo "Usage: keyclaude config set KEY=VAL" >&2; exit 1; }
      local key="${kv%%=*}"
      local val="${kv#*=}"
      mkdir -p "$HOME/.config/keyclaude"
      if [[ -f "$HOME/.config/keyclaude/config" ]] && grep -q "^${key}=" "$HOME/.config/keyclaude/config" 2>/dev/null; then
        sed -i '' "s|^${key}=.*|${key}=${val}|" "$HOME/.config/keyclaude/config"
      else
        echo "${key}=${val}" >> "$HOME/.config/keyclaude/config"
      fi
      echo "Set ${key}=${val} in ~/.config/keyclaude/config"
      ;;
    *)
      echo "Unknown config command: $cmd" >&2
      echo "Usage: keyclaude config [show|set KEY=VAL]" >&2
      exit 1
      ;;
  esac
}

cmd_review() {
  local target="${1:-}"
  local file=""

  case "$target" in
    backlog)
      file="$DATA_ROOT/backlog.md"
      ;;
    work-log)
      file="$DATA_ROOT/work-log.md"
      ;;
    writing)
      file="$DATA_ROOT/writing-insights.md"
      ;;
    weekly)
      local week="${2:-$(date +"%Y-W%V")}"
      file="$DATA_ROOT/weekly/${week}.md"
      ;;
    *)
      echo "Unknown review target: $target" >&2
      echo "Usage: keyclaude review [backlog|work-log|weekly [N]|writing]" >&2
      exit 1
      ;;
  esac

  if [[ ! -f "$file" ]]; then
    echo "File not found: $file" >&2
    exit 1
  fi

  echo "Opening in Plannotator: $file"
  plannotator annotate "$file"
}

case "${1:-help}" in
  help|-h|--help)  cmd_help ;;
  install)         cmd_install ;;
  config)          cmd_config "${2:-}" "${3:-}" ;;
  review)          cmd_review "${2:-}" "${3:-}" ;;
  *)               cmd_help ;;
esac
